{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gnomeconquest",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    // The Worker now answers /api/* itself and falls through to the bundle for
    // everything else, so it needs the binding rather than a plain static mount.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // One Durable Object per room. Cloudflare guarantees a single instance per
  // id worldwide, which is what makes the room's state authoritative rather
  // than merely agreed-upon.
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    }
  ],
  // Per-IP limits on the endpoints reachable before a room has agreed to
  // hold you (src/worker/routes.ts). Inside a room the limiting is the room's
  // own — per connection and per room, see src/net/ratelimit.ts.
  //
  // The namespace ids are local to this Worker and just have to be distinct.
  "ratelimits": [
    {
      // Minting a room code is cheap, and hosting a game night is a handful of
      // rooms an evening. Ten a minute is far more than that and far less than
      // a faucet.
      "name": "ROOM_CREATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Joining is the expensive door — addressing a room is what creates its
      // Durable Object. Sized for people, not for a code-space walk: a real
      // client dials once and then reconnects on backoff, and a household or
      // office behind one NAT address shares this budget, which is why it is
      // 60 and not 10.
      "name": "ROOM_JOIN_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // GET /api/health reads D1 on every call. A monitor checks it once a
      // minute; thirty is generous for people and stingy for a flood.
      "name": "HEALTH_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // Accounts (ACCOUNTS.md). One D1 database per environment; the schema is
  // the migrations/ folder, applied with `npm run db:migrate:*` BEFORE the code
  // that needs it is deployed (DEPLOYMENT.md).
  //
  // The id is pinned so a deploy can never provision, or pick up by name, a
  // different database. It is an identifier, not a credential: nothing can be
  // done with it without the account's own login or API token. Local runs
  // (wrangler dev, vite preview, the e2e suite) use a miniflare database under
  // .wrangler/ and never touch this one.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gnomeconquest",
      "database_id": "fcf26646-ced5-42fb-b28a-a14f2d3f6b37",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Staging: its own Worker, its own D1 database, its own Durable Object
  // namespace (so staging rooms and production rooms never meet) and, from
  // Phase 2, its own Google OAuth client and secrets. Bindings are not
  // inherited by an environment, so each is restated here. Built with
  // CLOUDFLARE_ENV=staging (`npm run deploy:staging`).
  //
  // Production data is never copied here, and nothing automated ever points at
  // a remote database: tests use an in-memory SQLite (src/worker/db/testDb.ts)
  // and local runs use miniflare's local D1 under .wrangler/.
  "env": {
    "staging": {
      "name": "gnomeconquest-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "RoomDurableObject"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "ROOM_CREATE_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "ROOM_JOIN_LIMIT",
          "namespace_id": "2002",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "HEALTH_LIMIT",
          "namespace_id": "2003",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gnomeconquest-staging",
          "database_id": "5da7b240-476d-4fb8-938a-7cabcf80a964",
          "migrations_dir": "migrations"
        }
      ],
      // Branch previews (Workers Builds, one per non-production branch) do NOT
      // inherit any binding above: a preview gets exactly what is declared
      // here, plus ASSETS. Without this block a preview has no DB and no
      // ROOMS, and /api/health answers 503.
      //
      // - DB is staging's own database, so a branch that adds a migration
      //   answers 503 on its preview until staging is migrated (migrate first).
      // - The rate limits are staging's, in namespaces of their own, so
      //   preview traffic never spends staging's budget.
      // - Vars and secrets, when there are any, must be declared here too
      //   (secrets with `wrangler preview secret put`).
      //
      // There is deliberately no top-level "previews": production builds no
      // branch previews, and a preview must never be bound to production's
      // database. src/worker/previewConfig.test.ts pins all of this.
      "previews": {
        "durable_objects": {
          "bindings": [
            {
              "name": "ROOMS",
              "class_name": "RoomDurableObject"
            }
          ]
        },
        "ratelimits": [
          {
            "name": "ROOM_CREATE_LIMIT",
            "namespace_id": "3001",
            "simple": { "limit": 10, "period": 60 }
          },
          {
            "name": "ROOM_JOIN_LIMIT",
            "namespace_id": "3002",
            "simple": { "limit": 60, "period": 60 }
          },
          {
            "name": "HEALTH_LIMIT",
            "namespace_id": "3003",
            "simple": { "limit": 30, "period": 60 }
          }
        ],
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "gnomeconquest-staging",
            "database_id": "5da7b240-476d-4fb8-938a-7cabcf80a964"
          }
        ]
      }
    }
  }
}
