{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    // No ambient @types packages: the Cloudflare runtime globals come from
    // worker-configuration.d.ts (below), and node/DOM types would collide with
    // them. The Worker's Request/Response/WebSocket are not the DOM's, which is
    // why this is a separate project from tsconfig.app.json at all.
    "types": [],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // worker-configuration.d.ts is generated by `npm run cf-typegen`; it is
  // committed so a clean `npm ci && npm run build` typechecks without wrangler.
  // types/vite-import-meta.d.ts types the engine's `import.meta.glob` (the
  // garden-preset registry) for a project that carries no vite/client.
  "include": ["src/worker", "worker-configuration.d.ts", "types"]
}
